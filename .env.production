# Конфигурация для продакшн окружения Amvera PostgreSQL
# Пример URL для подключения к Amvera PostgreSQL:
# DATABASE_URL=postgresql://calculator_user:password@amvera-limslava-cnpg-calculator-db-rw:5432/logistics_calculator
DATABASE_URL=postgresql://username:password@amvera-username-cnpg-project-name-rw:5432/database_name
NODE_ENV=production
PORT=3000
JWT_SECRET=your-very-secure-jwt-secret-key-here